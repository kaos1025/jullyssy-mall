# deploy/.env.app 로 복사 후 값 채우기 — chmod 600, 절대 커밋 금지
# Vercel 환경변수(Settings → Environment Variables, Production) 를 그대로 옮긴다.
#
#   docker compose -f deploy/docker-compose.app.yml up -d --build

# ---- 환경 식별 ----
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://jullyssy.shop
# ⚠️ 이름은 Vercel 이지만 반드시 production 으로 둔다.
#   CSRF 강제(lib/security/csrf.ts), dev 라우트 404 게이트(api/dev/email-preview), KV/Resend 필수 검증(lib/env.ts),
#   Sentry environment, 이메일 env 태그가 전부 VERCEL_ENV === "production" 을 본다. 비워두면 CSRF 가 fail-open 된다.
#   변수명 정리(APP_ENV 로 통일)는 컷오버 후 별도 PR.
VERCEL_ENV=production
NEXT_PUBLIC_VERCEL_ENV=production

# ---- Supabase (self-hosted, 같은 VPS) ----
NEXT_PUBLIC_SUPABASE_URL=https://api.jullyssy.shop
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Admin ----
ADMIN_EMAILS=

# ---- 토스페이먼츠 (live 키 — validateEnv 가 test_ 접두사를 거부한다) ----
NEXT_PUBLIC_TOSS_CLIENT_KEY=live_ck_
TOSS_SECRET_KEY=live_sk_

# ---- 크론 인바운드 인증 (pg_cron → pg_net → /api/cron/*) — Supabase vault 값과 동일해야 함 ----
CRON_SECRET=

# ---- 네이버 커머스 API ----
NAVER_COMMERCE_APP_ID=
NAVER_COMMERCE_SECRET=
# 앱이 VPS(고정 IP, 네이버 화이트리스트 등록된 IP) 에서 직접 나가므로 프록시 불필요.
# 비워두면 lib/naver.ts 가 직결한다. 다른 IP 에서 돌릴 때만 설정.
NAVER_PROXY_URL=

# ---- Upstash Redis (rate limit) ----
# Vercel Marketplace 통합은 Vercel 을 떠나면 사라진다. Upstash 콘솔(https://console.upstash.com) 에서
# 직접 DB 만들고 REST URL/TOKEN 을 넣는다 (무료 티어 10k 명령/일 — 현재 트래픽에 충분).
# 비워두면 isRateLimitEnabled=false → 모든 rate limit 이 fail-open (운영에서는 반드시 채울 것).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Resend (transactional email) ----
RESEND_API_KEY=
EMAIL_FROM="쥴리씨 <no-reply@jullyssy.shop>"

# ---- Sentry ----
NEXT_PUBLIC_SENTRY_DSN=
# 소스맵 업로드용 (선택). 없으면 빌드 시 업로드만 건너뛴다.
SENTRY_AUTH_TOKEN=

# ---- SEO / 분석 (선택) ----
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_NAVER_ANALYTICS_ID=
# Cloudflare Web Analytics 비콘 토큰 (@vercel/analytics 대체). 대시보드 → Analytics & Logs → Web Analytics.
NEXT_PUBLIC_CF_BEACON_TOKEN=

# ---- Google Search Console (gsc-sync 크론, 선택) ----
GSC_SITE_URL=
GOOGLE_SA_CLIENT_EMAIL=
GOOGLE_SA_PRIVATE_KEY=

# ---- 배송 추적 (shipping-poll 크론, 선택) ----
SWEET_TRACKER_API_KEY=

# ---- SEO AI 초안 월 예산 상한 (선택) ----
SEO_AI_MONTHLY_USD_CAP=

# ---- 점검 모드 (컷오버 시 1 로 켜면 middleware 가 503 반환) ----
JULLYSSY_CUTOVER_MAINTENANCE=0

# ---- Cafe24 (선택) ----
CAFE24_MALL_ID=
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
CAFE24_REDIRECT_URI=
CAFE24_OAUTH_STATE=jullyssy-cafe24-sync
