# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin
ADMIN_EMAILS=admin@example.com

# 토스페이먼츠
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_xxxxx
TOSS_SECRET_KEY=test_sk_xxxxx

# 네이버 커머스 API (Phase 6에서 사용)
NAVER_COMMERCE_APP_ID=
NAVER_COMMERCE_SECRET=

# 네이버 커머스 API egress 프록시 (선택) — VPS 고정IP 프록시 URL. 미설정 시 직결(로컬).
# 형식: http://<user>:<pass>@<vps-ip>:<port>
NAVER_PROXY_URL=

# Resend (transactional email)
# production은 validateEnv에서 강제 검증 (preview/dev는 미설정 허용, runtime throw)
# 발급: https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM="쥴리씨 <onboarding@resend.dev>"

# SEO 사이트 인증 (Naver Search Advisor / Google Search Console)
# 발급: https://searchadvisor.naver.com/ , https://search.google.com/search-console/
# 미설정 시 layout metadata에서 자동 생략됨
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# 네이버 애널리틱스(WCS) 추적ID — 발급: https://analytics.naver.com/
# 미설정 시 NaverAnalytics 컴포넌트가 아무것도 렌더/전송하지 않음
NEXT_PUBLIC_NAVER_ANALYTICS_ID=
